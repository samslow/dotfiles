# ~/.zshrc → ~/.dotfiles/zsh/zshrc
# 토큰 같은 비밀값·머신별 설정은 ~/.zshrc.local 에 (git 에 올라가지 않음)

# asdf (구버전 호환 — 0.16+ 는 .zshenv 의 shims PATH 로 충분)
[[ -f /opt/homebrew/opt/asdf/libexec/asdf.sh ]] && . /opt/homebrew/opt/asdf/libexec/asdf.sh

# ---------------------------------------------------------------- oh-my-zsh
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME=""   # 프롬프트는 아래 pure 가 담당

plugins=(
	git
	zsh-autosuggestions
	asdf
)

source $ZSH/oh-my-zsh.sh

# ---------------------------------------------------------------- prompt
autoload -U promptinit; promptinit
prompt pure

# ---------------------------------------------------------------- aliases & functions
source "$DOTFILES/zsh/aliases.zsh"
for f in "$DOTFILES"/zsh/functions/*.zsh(N); do source "$f"; done
unset f

# ---------------------------------------------------------------- env
export LANG=en_US.UTF-8

# pipx
export PATH="$PATH:$HOME/.local/bin"

# Antigravity
export PATH="$HOME/.antigravity/antigravity/bin:$PATH"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"

# eas autocomplete
EAS_AC_ZSH_SETUP_PATH="$HOME/Library/Caches/eas-cli/autocomplete/zsh_setup"
[[ -f $EAS_AC_ZSH_SETUP_PATH ]] && source "$EAS_AC_ZSH_SETUP_PATH"

# ---------------------------------------------------------------- local
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# zsh-syntax-highlighting 은 마지막에 로드해야 함
ZSH_HIGHLIGHT_SCRIPT="$ZSH_CUSTOM/plugins/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
[[ -f $ZSH_HIGHLIGHT_SCRIPT ]] && source "$ZSH_HIGHLIGHT_SCRIPT"
unset ZSH_HIGHLIGHT_SCRIPT
